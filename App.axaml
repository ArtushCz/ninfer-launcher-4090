<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NinferLauncher_v_2.App"
             xmlns:local="using:NinferLauncher_v_2"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Paleta: #1D1F21 #282A2E #373B41 #C5C8C6 #A54242 -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#1D1F21"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#C5C8C6"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#282A2E"/>
            <Setter Property="BorderBrush" Value="#373B41"/>
            <Setter Property="Foreground" Value="#C5C8C6"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#A54242"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#282A2E"/>
            <Setter Property="BorderBrush" Value="#373B41"/>
            <Setter Property="Foreground" Value="#C5C8C6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#A54242"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#282A2E"/>
            <Setter Property="BorderBrush" Value="#373B41"/>
            <Setter Property="Foreground" Value="#C5C8C6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="None"/>
        </Style>
        <Style Selector="Button TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33373E"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#282A2E"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#A54242"/>
            <Setter Property="BorderBrush" Value="#A54242"/>
            <Setter Property="Foreground" Value="#C5C8C6"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B54E4E"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#373B41"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282A2E"/>
        </Style>

        <Style Selector="ToggleButton.nav">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#282A2E"/>
        </Style>
        <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#282A2E"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>