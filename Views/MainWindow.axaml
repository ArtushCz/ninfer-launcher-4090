<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NinferLauncher_v_2"
        xmlns:vm="using:NinferLauncher_v_2.ViewModels"
        x:Class="NinferLauncher_v_2.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Icons/NinferLauncherIco.png"
        Title="Ninfer Launcher – RTX 4090"
        Width="1180" Height="720"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <!-- ====== Sidebar ====== -->
    <Grid ColumnDefinitions="64,*">
        <Border Grid.Column="0"
                Background="#1D1F21"
                BorderBrush="#373B41" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo at the top -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                    <Image Source="/Icons/NinferLauncherIco.png"
                           Width="32" Height="150"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Bottom: version + settings -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="-6,0,0,0">
                    <TextBlock Text="v2.0"
                               FontSize="11" Foreground="#4A4E55"
                               HorizontalAlignment="Center"/>
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsSettingsSelected, Mode=TwoWay}"
                                  ToolTip.Tip="Settings">
                        <Image Source="{x:Static local:IconSet.Settings}"
                               Width="24" Height="24" IsHitTestVisible="False"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Spacing="0" Margin="-6,0,0,0">
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsServerSelected, Mode=TwoWay}"
                                  ToolTip.Tip="Server launcher">
                        <Image Source="{x:Static local:IconSet.Server}"
                               Width="24" Height="24" IsHitTestVisible="False"/>
                    </ToggleButton>
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsChatSelected, Mode=TwoWay}"
                                  ToolTip.Tip="Chat">
                        <Image Source="{x:Static local:IconSet.Chat}"
                               Width="24" Height="24" IsHitTestVisible="False"/>
                    </ToggleButton>
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsHistorySelected, Mode=TwoWay}"
                                  ToolTip.Tip="History (coming soon)">
                        <Image Source="{x:Static local:IconSet.History}"
                               Width="24" Height="24" IsHitTestVisible="False"/>
                    </ToggleButton>
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsProfilesSelected, Mode=TwoWay}"
                                  ToolTip.Tip="Server profiles">
                        <Image Source="{x:Static local:IconSet.ServerProfile}"
                               Width="24" Height="24" IsHitTestVisible="False"/>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====== Content ====== -->
        <Border Grid.Column="1" Background="#1D1F21">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </Grid>
</Window>