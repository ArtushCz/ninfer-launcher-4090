<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NinferLauncher_v_2"
             xmlns:vm="using:NinferLauncher_v_2.ViewModels"
             x:Class="NinferLauncher_v_2.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="24,20,24,20" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0">
            <TextBlock Text="SETTINGS" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Settings are stored in %AppData%\NinferLauncher\settings.json"
                       FontSize="12" Foreground="#6E7279" Margin="0,2,0,16"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock Classes="cardtitle" Text="NINFER SERVER DIRECTORY"/>
                    <TextBox Text="{Binding ServerDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock FontSize="11" Foreground="#6E7279" Margin="0,4,0,0"
                               Text="{Binding FullModelPath}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="cardtitle" Text="MODEL FILE (.ninfer)"/>
                    <TextBox Text="{Binding ModelFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Width="150" Spacing="6">
                        <TextBlock Classes="cardtitle" Text="PORT"/>
                        <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="cardtitle" Text="DEFAULT PROFILE"/>
                    <ComboBox ItemsSource="{Binding Profiles}"
                                SelectedIndex="{Binding ProfileIndex, Mode=TwoWay}"
                                MaxWidth="420" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                    <Button Classes="primary" Command="{Binding SaveSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="5" HorizontalAlignment="Center">
                            <Image Source="{x:Static local:IconSet.Save}"/>
                            <TextBlock Text="Save settings"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="#8A8E94" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>