<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NinferLauncher_v_2"
             xmlns:controls="using:NinferLauncher_v_2.Controls"
             xmlns:vm="using:NinferLauncher_v_2.ViewModels"
             x:Class="NinferLauncher_v_2.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="24,20,24,20" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0">
            <TextBlock Text="SETTINGS" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Settings are stored in %AppData%\NinferLauncher\settings.json"
                       FontSize="12" Foreground="#6E7279" Margin="0,2,0,16"/>
        </StackPanel>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock Classes="cardtitle" Text="{Binding ServerCardTitle}"/>
                    <TextBox Text="{Binding ServerDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="cardtitle" Text="{Binding ModelCardTitle}"/>
                </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ModelRows}"
                                  SelectedItem="{Binding SelectedModelRow, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <controls:IconButton Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0"
                                VerticalAlignment="Center" CornerRadius="6" Padding="11"
                                IsVisible="{Binding ShowModelFilePicker}"
                                Command="{Binding PickModelFileCommand}"
                                Image="{x:Static local:IconSet.Folder}" 
                                IconSize="16"
                                ToolTip.Tip="Pick a .ninfer file from disk"
                                HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                        <controls:IconButton Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0"
                                VerticalAlignment="Center" CornerRadius="6" Padding="11"
                                IsVisible="{Binding ShowModelFolderPicker}"
                                Command="{Binding PickModelFolderCommand}"
                                Image="{x:Static local:IconSet.Folder}" IconSize="16"
                                ToolTip.Tip="Pick a model directory (vLLM)"
                                HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="#6E7279" Margin="0,4,0,0"
                               Text="{Binding FullModelPath}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Width="150" Spacing="6">
                        <TextBlock Classes="cardtitle" Text="PORT"/>
                        <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="cardtitle" Text="DEFAULT PROFILE"/>
                    <ComboBox ItemsSource="{Binding ProfileRows}"
                                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" Background="{Binding Band}">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Background="{Binding GroupBrushFaint}" BorderBrush="{Binding GroupBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10"
                            HorizontalAlignment="Left" MaxWidth="560">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3"
                                        VerticalAlignment="Top">
                                <TextBlock Text="Context:" Foreground="#8A8E94"/>
                                <TextBlock Text="MTP:" Foreground="#8A8E94"/>
                                <TextBlock Text="KV cache:" Foreground="#8A8E94"/>
                                <TextBlock Text="Vision:" Foreground="#8A8E94"/>
                                <TextBlock Text="Binary:" Foreground="#8A8E94"/>
                            </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding InfoEngine}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding InfoContext}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InfoMtp}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InfoKv}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding InfoVision}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedProfile.ExeName}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{Binding GroupBrush}"
                               Text="{Binding InfoGroupNote}"/>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <controls:IconButton Command="{Binding SaveSettingsCommand}"
                                Height="32" MinWidth="160" CornerRadius="6" Padding="0,0" IconSize="16"
                                Image="{x:Static local:IconSet.Save}"
                                Label="Save settings" LabelBrush="#C5C8C6"
                                 HighlightBrush="#B54E4E" PressedHighlightBrush="#33373E"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="#8A8E94" TextWrapping="Wrap"
                               HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
