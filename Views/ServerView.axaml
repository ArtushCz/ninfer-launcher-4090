<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NinferLauncher_v_2"
             xmlns:controls="using:NinferLauncher_v_2.Controls"
             xmlns:vm="using:NinferLauncher_v_2.ViewModels"
             x:Class="NinferLauncher_v_2.Views.ServerView"
             x:DataType="vm:ServerViewModel">

    <Grid Margin="24,20,24,20" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ====== Header ====== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#282A2E" BorderBrush="#373B41" BorderThickness="1"
                        CornerRadius="14" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SERVER LAUNCHER" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Ninfer • RTX 4090" FontSize="12"
                           Foreground="#6E7279" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ====== Server settings ====== -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,*">
                <!-- left column: directory + model -->
                <Grid Grid.Column="0" Margin="0,0,18,0" ColumnDefinitions="*,Auto"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Classes="cardtitle"
                               Text="{Binding Settings.ServerCardTitle}"/>
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding Settings.ServerDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:IconButton Grid.Row="1" Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0"
                            VerticalAlignment="Center" CornerRadius="6" Padding="12"
                            Command="{Binding BrowseDirCommand}"
                            Image="{x:Static local:IconSet.Folder}" IconSize="16"
                            ToolTip.Tip="Select server directory"
                            HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="cardtitle"
                               Text="{Binding Settings.ModelCardTitle}" Margin="0,12,0,6"/>
                    <ComboBox Grid.Row="3" Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Settings.ModelRows}"
                              SelectedItem="{Binding Settings.SelectedModelRow, Mode=TwoWay}"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <controls:IconButton Grid.Row="3" Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0"
                            VerticalAlignment="Center" CornerRadius="6" Padding="12"
                            IsVisible="{Binding Settings.ShowModelFilePicker}"
                            Command="{Binding Settings.PickModelFileCommand}"
                            Image="{x:Static local:IconSet.Folder}" IconSize="16"
                            ToolTip.Tip="Pick a .ninfer file from disk"
                            HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                    <controls:IconButton Grid.Row="3" Grid.Column="1" Width="40" Height="36" Margin="8,0,0,0"
                            VerticalAlignment="Center" CornerRadius="6" Padding="12"
                            IsVisible="{Binding Settings.ShowModelFolderPicker}"
                            Command="{Binding Settings.PickModelFolderCommand}"
                            Image="{x:Static local:IconSet.Folder}" IconSize="16"
                            ToolTip.Tip="Pick a model directory (vLLM)"
                            HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" FontSize="11" Foreground="#6E7279"
                               Margin="0,8,0,0" Text="{Binding Settings.FullModelPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Settings.FullModelPath}"/>
                </Grid>

                <!-- right column: profile, port, token -->
                <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,0,0">
                    <!-- Engine switcher: the visible NINFER / VLLM toggle -->
                    <TextBlock Classes="cardtitle" Text="ENGINE"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Left" MaxWidth="360">
                        <controls:IconButton Width="80" Height="32" CornerRadius="6" Padding="0"
                                Background="{Binding Settings.NinferToggleBackground}"
                                BorderBrush="{Binding Settings.NinferToggleBorder}" BorderThickness="1"
                                Label="NINFER" LabelFontSize="12"
                                LabelBrush="{Binding Settings.NinferToggleLabelBrush}" LabelOnly="True"
                                IsEnabled="{Binding Settings.CanSelectNinferEngine}"
                                Command="{Binding Settings.SelectNinferEngineCommand}"
                                ToolTip.Tip="Native Ninfer engine (ninfer-serve.exe) – .ninfer model files"
                                HighlightBrush="#3A3F46" PressedHighlightBrush="#3A3F46"/>
                        <controls:IconButton Width="80" Height="32" CornerRadius="6" Padding="0" 
                                Background="{Binding Settings.VllmToggleBackground}"
                                BorderBrush="{Binding Settings.VllmToggleBorder}" BorderThickness="1"
                                Label="vLLM" LabelFontSize="12"
                                LabelBrush="{Binding Settings.VllmToggleLabelBrush}" LabelOnly="True"
                                IsEnabled="{Binding Settings.CanSelectVllmEngine}"
                                Command="{Binding Settings.SelectVllmEngineCommand}"
                                ToolTip.Tip="vLLM (python\python.exe from the vLLM directory) – HuggingFace model directories"
                                HighlightBrush="#3A3F46" PressedHighlightBrush="#3A3F46"/>
                    </StackPanel>
                    <TextBlock Classes="cardtitle" Text="SERVER PROFILE" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding Settings.ProfileRows}"
                              SelectedItem="{Binding Settings.SelectedRow, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              MinWidth="380">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" Background="{Binding Band}">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Margin="0,10,0,0" Background="{Binding Settings.GroupBrushFaint}"
                            BorderBrush="{Binding Settings.GroupBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="3"
                                        VerticalAlignment="Top">
                                <TextBlock Text="Engine:" Foreground="#8A8E94"/>
                                <TextBlock Text="Context:" Foreground="#8A8E94"/>
                                <TextBlock Text="MTP:" Foreground="#8A8E94"/>
                                <TextBlock Text="KV cache:" Foreground="#8A8E94"/>
                                <TextBlock Text="Vision:" Foreground="#8A8E94"/>
                                <TextBlock Text="Binary:" Foreground="#8A8E94"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Settings.InfoEngine}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Settings.InfoContext}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Settings.InfoMtp}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Settings.InfoKv}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Settings.InfoVision}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Settings.SelectedProfile.ExeName}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{Binding Settings.GroupBrush}"
                               Text="{Binding Settings.InfoGroupNote}"/>
                    <Border Background="#332A1A" BorderBrush="#8A6D1F" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                            IsVisible="{Binding Settings.SelectedProfile.WarnHighContext}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="{x:Static local:IconSet.Warning}" Width="24" Height="24"
                                   VerticalAlignment="Center"/>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Context above 240K" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#E5B94E"/>
                                <TextBlock FontSize="11" Foreground="#C8A96A" TextWrapping="Wrap"
                                           Text=""/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="11" Foreground="#6E7279" Margin="0,8,0,0"
                        IsVisible="{Binding Settings.ShowWddmOption}"
                       Text="Ceilings measured on an RTX 4090 24 GB (--wddm-evictable-budget). Default: 240K + MTP3."/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                        <StackPanel Width="150" Spacing="6">
                            <TextBlock Classes="cardtitle" Text="PORT"/>
                            <TextBox Text="{Binding Settings.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding Settings.WddmEvictableBudget, Mode=TwoWay}"
IsVisible="{Binding Settings.ShowWddmOption}"
                              Content="--wddm-evictable-budget"
                              FontSize="12" Foreground="#C5C8C6" Margin="0,10,0,0"
                              ToolTip.Tip="Pass --wddm-evictable-budget to the server at startup: the WDDM driver may reclaim evictable VRAM pages under pressure instead of the server failing. Recommended on Windows."/>
                    <TextBlock FontSize="11" Foreground="#6E7279" Margin="0,12,0,0"
                               Text="{Binding Settings.UrlText}"
                               ToolTip.Tip="Server address for the API"/>
                </StackPanel>
            </Grid>
        </Border>
<!-- ====== Server controls ====== -->
        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <controls:IconButton Grid.Column="0" MinWidth="150" Height="32" CornerRadius="6" Padding="0,0" IconSize="16"
                    Command="{Binding StartServerCommand}" IsEnabled="{Binding !IsRunning}"
                    Image="{x:Static local:IconSet.Start}"
                    Label="Start" LabelBrush="#C5C8C6" Background="#2D5A27"
                    HighlightBrush="#4B8B3B" PressedHighlightBrush="#33373E"/>
            <controls:IconButton Grid.Column="1" MinWidth="150" Height="32" CornerRadius="6"  Padding="0,0,0,0" IconSize="16"
                    Command="{Binding StopServerCommand}" IsEnabled="{Binding IsRunning}"
                    Image="{x:Static local:IconSet.Stop}"
                    Label="Stop" LabelBrush="#C5C8C6" BorderBrush="#373B41"  Background="#8B0000"
                    HighlightBrush="#33373E" PressedHighlightBrush="#33373E" Margin="16,0,0,0"/>
            <controls:IconButton Grid.Column="2" MinWidth="150" Height="32" CornerRadius="6" Padding="0,0,0,0" IconSize="16"
                    Command="{Binding RestartServerCommand}" Margin="16,0,0,0"
                    Image="{x:Static local:IconSet.Restart}"
                    Label="Restart" LabelBrush="#C5C8C6" BorderBrush="#373B41"
                    HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
            <!-- Clickable link: opens the server UI in the default web browser. -->
            <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0"
                    Cursor="Hand" Focusable="False" Command="{Binding OpenUrlCommand}"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    ToolTip.Tip="Open the server UI in a browser">
                <Button.Template>
                    <ControlTemplate>
                        <ContentPresenter Background="Transparent" Cursor="Hand"/>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Margin="5" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Image Source="{x:Static local:IconSet.Link}" Width="18" Height="18"
                           Opacity="0.6" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Settings.UrlText}" FontSize="12" Foreground="#8A8E94"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ====== Hardware monitor ====== -->
        <Border Grid.Row="3" Classes="card" Margin="0,0,0,12">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Grid.Row="0" Classes="cardtitle" Text="HARDWARE MONITOR"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock FontSize="11" Foreground="#8A8E94" Text="GPU MEMORY"/>
                        <controls:StatBar Height="6" Value="{Binding GpuMemPct}"
                                Fill="{Binding GpuMemBarBrush}"
                                ToolTip.Tip="Dedicated GPU memory – used / total (nvidia-smi)"/>
                        <TextBlock Text="{Binding GpuMemText}" FontSize="11" Foreground="#8A8E94"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock FontSize="11" Foreground="#8A8E94" Text="GPU USAGE"/>
                        <controls:StatBar Height="6" Value="{Binding GpuUsePct}"
                                Fill="{Binding GpuUseBarBrush}"
                                ToolTip.Tip="GPU engine utilisation across all engines"/>
                        <TextBlock Text="{Binding GpuUseText}" FontSize="11" Foreground="#8A8E94"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock FontSize="11" Foreground="#8A8E94" Text="MEMORY USAGE"/>
                        <controls:StatBar Height="6" Value="{Binding RamPct}"
                                Fill="{Binding RamPctBarBrush}"
                                ToolTip.Tip="System RAM in use (Task Manager 'In use')"/>
                        <TextBlock Text="{Binding RamPctText}" FontSize="11" Foreground="#8A8E94"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="5">
                        <TextBlock FontSize="11" Foreground="#8A8E94" Text="MEMORY"/>
                        <controls:StatBar Height="6" Value="{Binding RamMemPct}"
                                Fill="{Binding RamMemBarBrush}"
                                ToolTip.Tip="System RAM – used / total physical"/>
                        <TextBlock Text="{Binding RamMemText}" FontSize="11" Foreground="#8A8E94"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ====== Terminal ====== -->
        <Border Grid.Row="4" Background="#1D1F21"
                BorderBrush="#373B41" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#282A2E"
                        CornerRadius="9,9,0,0" Padding="14,9">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="11" Foreground="#6E7279"
                                       Text="{Binding Terminal.Count, StringFormat='Lines: {0}'}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TpsStatusText}" FontSize="11"
                                       Foreground="#8A8E94" VerticalAlignment="Center"
                                       ToolTip.Tip="Live throughput from the server log (current and average)"/>
                            <controls:IconButton Width="40" Height="36" CornerRadius="6" Padding="6"
                                    Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy entire terminal log to clipboard"
                                    Image="{x:Static local:IconSet.Copy}" IconSize="24"
                                    HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                            <controls:IconButton Width="40" Height="36" CornerRadius="6" Padding="6"
                                    Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear terminal"
                                    Image="{x:Static local:IconSet.Trash}" IconSize="24"
                                    HighlightBrush="#33373E" PressedHighlightBrush="#33373E"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="SERVER TERMINAL" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#8A8E94"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="TermScroll" Margin="10" Focusable="True" Cursor="IBeam"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ToolTip.Tip="Click a line to copy it; drag across lines to select and copy several; Shift+click to extend"
                              PointerPressed="OnTermPointerPressed"
                              PointerMoved="OnTermPointerMoved"
                              PointerReleased="OnTermPointerReleased">
                    <!-- Terminal lines are selectable: press to anchor, drag across lines to
                         extend the selection (live highlight), release to copy; Shift+click
                         extends from the anchor. The Copy button copies the whole log. -->
                    <ItemsControl x:Name="TermList" ItemsSource="{Binding Terminal}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundBrush}" Padding="2,0">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding Brush}"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               FontSize="12.5"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel x:Name="TermPanel"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
